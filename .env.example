# Groq API key cho Dashboard AI (lấy tại https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini API key dự phòng khi Groq hết token (lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq API key & Model riêng cho AI chăm sóc khách hàng (Bảo mẫu AECPT)
GROQ_SUPPORT_API_KEY=
GROQ_SUPPORT_MODEL=llama-3.3-70b-versatile

PORT=3000
