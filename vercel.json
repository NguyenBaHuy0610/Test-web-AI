{
  "version": 2,
  "rewrites": [
    {
      "source": "/config.js",
      "destination": "/api/config"
    },
    {
      "source": "/algorithm/(.*)",
      "destination": "/algorithm/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}

